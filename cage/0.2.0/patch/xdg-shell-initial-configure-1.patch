 	/* When an xdg_surface performs an initial commit, the compositor must
-	 * reply with a configure so the client can map the surface. */
+	 * reply with a configure so the client can map the surface. Schedule
+	 * it EXPLICITLY: the configure implicitly generated by the maximize
+	 * below is scheduled while the surface is still uninitialized and
+	 * never reaches the client, which then renders its first frame at
+	 * 0x0 and aborts (GTK 4.16: 'Unable to create Cairo image surface:
+	 * invalid value (typically too big)'). Mirrors upstream commits
+	 * 0f0c637a06 / 5f83b27d62 / 350e2ef8b9. */
+	wlr_xdg_surface_schedule_configure(xdg_shell_view->xdg_toplevel->base);
 	view_position(&xdg_shell_view->view);
